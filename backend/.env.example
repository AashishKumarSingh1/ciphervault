# CipherVault Environment Configuration Example
# Copy this to .env before starting the backend

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security & Master Key (32 bytes / 64 hex characters)
# Generate a new random key with: python -c "import secrets; print(secrets.token_hex(32))"
CIPHERVAULT_MASTER_KEY=4a8e9d3c5b2f1a0e7d6c8b4a2f9e1d3c5b7a9e0f2d4c6b8a1e3f5d7c9b0a2e4f

# Lab Test Key for Cryptographic Playground Demonstrations
CIPHERVAULT_TEST_KEY=d1f2e3a4b5c67890123456789abcdef0123456789abcdef0123456789abcdef0

# Database
DATABASE_URL=sqlite:///./ciphervault.db

# Session Settings
SESSION_SECRET=ciphervault-secure-session-secret-key-change-in-prod-32bytes
SESSION_EXPIRE_HOURS=24
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
